# Port to listen on
PORT=3000
# Public base URL, used in the links Botkin hands to bots
PUBLIC_URL=http://localhost:3000
# SQLite file; keep it on a persistent volume in production
DB_PATH=./data/botkin.db
# Sign in with X (developer.x.com: OAuth 2.0, type "Web App", confidential client,
# callback URL = PUBLIC_URL + /auth/x/callback, scopes users.read tweet.read)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Tests/dev only: allows fake X logins at /login/<code>/dev. Never set in production.
# BOTKIN_DEV_LOGIN=1
