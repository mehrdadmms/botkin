# Port to listen on
PORT=3000
# Public base URL, used in the links Botkin hands to bots
PUBLIC_URL=http://localhost:3000
# SQLite file; keep it on a persistent volume in production
DB_PATH=./data/botkin.db
# Sign in with X (developer.x.com: OAuth 2.0, type "Web App", confidential client,
# callback URL = PUBLIC_URL + /auth/x/callback, scopes users.read tweet.read)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Tests/dev only: allows fake X logins at /login/<code>/dev. Never set in production.
# BOTKIN_DEV_LOGIN=1
# Optional AI prompt-injection check via OpenRouter (~$0.07 per 1,000 messages with the default model).
# Use a key made only for Botkin, with a credit limit set on OpenRouter.
OPENROUTER_API_KEY=
# BOTKIN_GUARD_MODEL=anthropic/claude-haiku-5.5
# BOTKIN_GUARD_DAILY_LIMIT=5000
